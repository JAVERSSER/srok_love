{
  "expo": {
    "name": "SrokLove",
    "slug": "sroklove",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sroklove",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#E7275E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sroklove.app"
    },
    "android": {
      "package": "com.sroklove.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SrokLove uses your location to show people near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SrokLove needs access to your photos so you can add them to your profile."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E7275E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}

{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy?__path=api/:path*" },
    { "source": "/media/:path*", "destination": "/api/proxy?__path=media/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
